rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper function ──────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null;
    }

    // ── Public read-only collections ─────────────────────────────────────────
    // Anyone can read profile, gallery, achievements, awards, etc.
    // Only authenticated admins can write.

    match /profile/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /gallery/{docId} {
      allow read:  if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAny(['url', 'category', 'title', 'caption', 'publicId', 'createdAt']);
    }

    match /achievements/{docId} {
      allow read:  if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAny(['title', 'description', 'year']);
    }

    match /awards/{docId} {
      allow read:  if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAny(['title', 'description', 'year']);
    }

    match /certificates/{docId} {
      allow read:  if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAny(['title', 'description', 'year', 'type']);
    }

    match /connections/{docId} {
      allow read:  if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasAny(['title', 'description', 'year']);
    }

    match /services/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Public Contact Messages ───────────────────────────────────────────────
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ── Settings — site assets only accessible to admins for write ───────────
    match /settings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Block everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read:  if false;
      allow write: if false;
    }
  }
}
